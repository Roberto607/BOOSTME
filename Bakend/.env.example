# Environment variables used by the Django backend.
# Copy this file to .env and fill in your own values.
# These localhost values are only for development.
# In Render, set FRONTEND_URL and BACKEND_URL to your real service URLs.

DEBUG=True
SECRET_KEY=your-secret-key

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=BoostMe <your.email@gmail.com>

# Database settings for local development
POSTGRES_DB=boostme_db
POSTGRES_USER=boostme
POSTGRES_PASSWORD=2025
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
