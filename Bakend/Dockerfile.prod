FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema necesarias
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libopenjp2-7-dev \
    libtiff5-dev \
    tk-dev \
    tcl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements.txt e instalar dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar el código de la aplicación
COPY . .

# Permitir un fallback temporal a SQLite solo durante la construcción
ARG USE_SQLITE_FALLBACK=true
RUN USE_SQLITE_FALLBACK=${USE_SQLITE_FALLBACK} python manage.py collectstatic --noinput

# Exponer el puerto 8000
EXPOSE 8000

# Comando de inicio para que el contenedor no termine inmediatamente
CMD ["sh", "-c", "python manage.py migrate --noinput && python scripts/create_superuser_no_signals.py && exec gunicorn Bakend.wsgi:application --bind 0.0.0.0:8000"]


