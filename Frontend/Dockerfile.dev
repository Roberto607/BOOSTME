# Usa la imagen oficial de Node
FROM registry.cn-hangzhou.aliyuncs.com/library/node:20-alpine


# Directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiamos el package.json y package-lock.json (si existe)
COPY package*.json ./

# Instalamos dependencias
RUN npm install

# Copiamos el resto del proyecto
COPY . .

# Exponemos el puerto de Vite (por defecto 5173)
EXPOSE 5173

# Comando para ejecutar el servidor de desarrollo de Vite
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

