FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

# Ensure Browserslist data is up-to-date to avoid the caniuse-lite warning during build.
# This updates the local DB used by tooling like Vite/Autoprefixer. Allow failure so build
# continues even if the update cannot run in the environment.
RUN npx update-browserslist-db@latest --update-db --allow-root || true

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

