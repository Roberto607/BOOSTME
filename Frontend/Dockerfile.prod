FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
# Prefer `npm ci` in CI environments for reproducible installs; fall back to `npm install`
# with legacy peer deps if `ci` is not possible (e.g., no package-lock present).
RUN npm ci --silent || npm install --legacy-peer-deps --silent

# Avoid failing builds due to an old caniuse-lite DB in restricted environments (Render free).
# Also attempt to update the DB during the image build; allow failure.
ENV BROWSERSLIST_IGNORE_OLD_DATA=1
RUN npx update-browserslist-db@latest --update-db --allow-root || true

# Hint to Node/Vite that this is a production build
ENV NODE_ENV=production

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

